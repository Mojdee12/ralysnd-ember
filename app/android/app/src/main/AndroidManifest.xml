<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Build 2077: the app lock's fingerprint / face unlock
         (framework BiometricPrompt); a normal permission,
         granted automatically at install. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Build 2065: the boot flag for auto-connect (BootReceiver
         only records that a boot happened; it starts nothing). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Build 2075: the in-app updater installs the APK it
         downloaded from the app's GitHub Releases feed; Android
         gates that behind this permission plus the per-app
         "install unknown apps" grant (checked at install time). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The apps a user can route: also the system's, which have no icon
         (Google Play services, the download manager). The app is not on
         Google Play, whose rules limit this permission. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />
    <application
        android:label="@string/app_name"
        android:name=".EmberApplication"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Build 2085 (audit F-H15): "Open with Ember" for
                 .ovpn files from Files/Telegram, and share-to-Ember
                 from Telegram. VIEW matches a file URI whose path
                 ends .ovpn (either scheme, with or without the MIME
                 type the sending app reports — Files sends one,
                 some senders send none); SEND matches the MIME
                 types a shared .ovpn file or pasted config text
                 arrives with. MainActivity reads the file (the
                 picker's 256 KB cap) and forwards {name, content}
                 to Dart, which imports it through the same path
                 the file/paste buttons use — the Dart parser, not
                 the filter, is what rejects a non-.ovpn payload. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:pathPattern=".*\\.ovpn" />
                <data android:scheme="content" android:pathPattern=".*\\.OVPN" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.ovpn" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.OVPN" />
                <data android:scheme="file" android:pathPattern=".*\\.ovpn" />
                <data android:scheme="file" android:pathPattern=".*\\.OVPN" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.ovpn" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.OVPN" />
            </intent-filter>
            <!-- Build 2102 (wg-ipv6-import-diagnosis.md,
                 I1): "Open with Ember" for .conf files too —
                 builds ≤2101 declared only the .ovpn filter,
                 so Ember was never offered for a WireGuard
                 config in Files/Telegram. The payload rides
                 the same intake as .ovpn; the Dart side
                 content-routes it to the WireGuard importer
                 (ember_shell._importOpenVpnIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:pathPattern=".*\\.conf" />
                <data android:scheme="content" android:pathPattern=".*\\.CONF" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.conf" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.CONF" />
                <data android:scheme="file" android:pathPattern=".*\\.conf" />
                <data android:scheme="file" android:pathPattern=".*\\.CONF" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.conf" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.CONF" />
            </intent-filter>
            <!-- Build 2095 (whole-app journey audit #38):
                 config links open in Ember — the app-specific
                 schemes only. A generic https filter is
                 deliberately NOT declared: unverified, it would
                 make Ember a candidate for every web link;
                 subscription URLs are imported by paste, scan
                 or file inside the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="wireguard" />
                <data android:scheme="wg" />
                <!-- Build 2157 (feature pick 1): OpenVPN
                     profile links — the payload form and
                     the official import-profile form; the
                     Dart side routes them to the OpenVPN
                     importer (ovpn_link.dart). -->
                <data android:scheme="ovpn" />
                <data android:scheme="openvpn" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-openvpn-profile" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Build 2075: serves the downloaded update APK to the
             system installer (see res/xml/ember_file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ember_file_paths" />
        </provider>
        <!-- The VPN: runs the Go core and carries the phone's traffic. -->
        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through an encrypted proxy." />
        </service>
        <!-- The V2Ray engine's VPN: the Xray subprocess and the TUN
             bridge. Never up at the same time as CoreService's VPN; the
             app turns one off before the other on. -->
        <service
            android:name=".XrayVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the Xray core." />
        </service>
        <!-- The Psiphon engine's service: the tunnel core runs
             (gomobile AAR) in both of its modes — as a VPN with
             the TUN bridge, or proxy-only without one. Never up at
             the same time as the other engines; the app turns one
             off before another on.
             Build 2073: the service runs in its OWN process
             (:psiphon). The Psiphon gomobile runtime (pg) wedged
             on its first call in the main process, where the
             Mozilla gomobile runtime (go) is already loaded and
             started at every app launch — in ralysnd, where the
             same stack works, the pg runtime is the first and
             only gomobile runtime in its process. Isolation
             restores that condition in any engine order. All
             main-process interaction is intent- and file-based
             (see PsiphonVpnService's published state file), so
             nothing else about the engine changes. No other
             component runs in its own process. -->
        <service
            android:name=".PsiphonVpnService"
            android:process=":psiphon"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the Psiphon core." />
        </service>
        <!-- The AmneziaWG engine's VPN (build 2104): WG
             Tunnel's backend (com.wgtunnel:backend) declares
             its OWN services from its artifact manifest — its
             VpnService (main process, not a foreground
             service) and its VpnCompanionService (specialUse
             foreground service carrying the notification) —
             so Ember declares none for this engine. Builds
             2100–2103 declared .AwgVpnService here in a
             dedicated :awg process; that declaration, the
             process and the service are deleted (named loss,
             BUILD-LOG-2.md). Never up at the same time as the
             other engines; the app turns one off before
             another on. -->
        <!-- The Lantern engine's VPN (build 2024; gomobile
             swap build 2129): the official Lantern client's
             gomobile core (liblantern_gojni.so) runs in-process
             through the lantern-plugin.dex bindings.
             Build 2129: the service runs in its OWN process
             (:lantern), mirroring the :psiphon precedent — two
             gomobile Go runtimes in one process are
             unsupported, and Mozilla's already lives in the
             main process. All main-process interaction is
             intent- and file-based (see LanternVpnService's
             published state file). Never up at the same time
             as the other engines; the app turns one off before
             another on. -->
        <service
            android:name=".LanternVpnService"
            android:process=":lantern"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the Lantern core." />
        </service>
        <!-- The URnetwork engine's VPN (build 2156): the
             URnetwork SDK's gomobile core (liburcore.so — the
             vendor libgojni.so, shaded) runs in-process
             through the DeviceLocal API; this service
             establishes the TUN and hands the SDK a duplicate
             of its fd. Like Lantern and Psiphon, the service
             runs in its OWN process (:urnetwork) — two
             gomobile Go runtimes in one process are
             unsupported, and Mozilla's already lives in the
             main process. All main-process interaction is
             intent- and file-based (see UrVpnService's
             published state file). Never up at the same time
             as the other engines; the app turns one off before
             another on. -->
        <service
            android:name=".UrVpnService"
            android:process=":urnetwork"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the URnetwork core." />
        </service>
        <!-- The OpenVPN engine's VPN (build 2025): the OpenVPN 3
             core, rebuilt from source behind Ember's own JNI
             bridge, drives this service's TUN through its
             callbacks. Never up at the same time as the other
             engines; the app turns one off before another on. -->
        <service
            android:name=".OpenVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the OpenVPN core." />
        </service>
        <!-- The Quick Settings tile that turns the proxy on or off. -->
        <service
            android:name=".QuickTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_logo"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- The home-screen widget: a button that turns the VPN on or off. -->
        <receiver
            android:name=".ConnectWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_connect_info" />
        </receiver>
        <!-- The widget button's tap; only the widget's PendingIntent reaches it. -->
        <receiver
            android:name=".ConnectWidget$Toggle"
            android:exported="false" />
        <!-- Build 2065: records boots for the auto-connect trigger. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- The apps with an icon, which the routing page lists first. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
