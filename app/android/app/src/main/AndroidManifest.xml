<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Build 2065: the boot flag for auto-connect (BootReceiver
         only records that a boot happened; it starts nothing). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The apps a user can route: also the system's, which have no icon
         (Google Play services, the download manager). The app is not on
         Google Play, whose rules limit this permission. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />
    <application
        android:label="@string/app_name"
        android:name=".EmberApplication"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The VPN: runs the Go core and carries the phone's traffic. -->
        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through an encrypted proxy." />
        </service>
        <!-- The V2Ray engine's VPN: the Xray subprocess and the TUN
             bridge. Never up at the same time as CoreService's VPN; the
             app turns one off before the other on. -->
        <service
            android:name=".XrayVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the Xray core." />
        </service>
        <!-- The Psiphon engine's service: the tunnel core runs
             (gomobile AAR) in both of its modes — as a VPN with
             the TUN bridge, or proxy-only without one. Never up at
             the same time as the other engines; the app turns one
             off before another on.
             Build 2073: the service runs in its OWN process
             (:psiphon). The Psiphon gomobile runtime (pg) wedged
             on its first call in the main process, where the
             Mozilla gomobile runtime (go) is already loaded and
             started at every app launch — in ralysnd, where the
             same stack works, the pg runtime is the first and
             only gomobile runtime in its process. Isolation
             restores that condition in any engine order. All
             main-process interaction is intent- and file-based
             (see PsiphonVpnService's published state file), so
             nothing else about the engine changes. No other
             component runs in its own process. -->
        <service
            android:name=".PsiphonVpnService"
            android:process=":psiphon"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the Psiphon core." />
        </service>
        <!-- The Lantern engine's VPN (build 2024): the radiance
             core runs as a subprocess (liblantern.so) serving a
             local SOCKS proxy that the TUN bridge exits through.
             Never up at the same time as the other engines; the
             app turns one off before another on. -->
        <service
            android:name=".LanternVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the Lantern core." />
        </service>
        <!-- The OpenVPN engine's VPN (build 2025): the OpenVPN 3
             core, rebuilt from source behind Ember's own JNI
             bridge, drives this service's TUN through its
             callbacks. Never up at the same time as the other
             engines; the app turns one off before another on. -->
        <service
            android:name=".OpenVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A VPN that carries the device's traffic through the OpenVPN core." />
        </service>
        <!-- The Quick Settings tile that turns the proxy on or off. -->
        <service
            android:name=".QuickTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_logo"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- The home-screen widget: a button that turns the VPN on or off. -->
        <receiver
            android:name=".ConnectWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_connect_info" />
        </receiver>
        <!-- The widget button's tap; only the widget's PendingIntent reaches it. -->
        <receiver
            android:name=".ConnectWidget$Toggle"
            android:exported="false" />
        <!-- Build 2065: records boots for the auto-connect trigger. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- The apps with an icon, which the routing page lists first. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
