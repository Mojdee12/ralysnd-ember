// The pinned radiance tree, extracted by
// scripts/fetch-windows-sidecars.ps1 into tools/radiance-src
// (the same tree lanternd.exe is built from).
replace github.com/getlantern/radiance => ../tools/radiance-src

// Mirrored from radiance's go.mod (replace directives do
// not propagate across modules): Lantern's forks of
// sing-box, sing-shadowsocks, wazero, water, outline-sdk
// and the pinned gvisor are what radiance compiles
// against; without them the stock modules skew (water vs
// upstream wazero) and the bridge does not build.
replace github.com/sagernet/sing-box => github.com/getlantern/sing-box-minimal v1.14.2-lantern.3

replace github.com/sagernet/sing-shadowsocks => github.com/getlantern/sing-shadowsocks v0.2.8-lantern.3

replace github.com/tetratelabs/wazero => github.com/getlantern/wazero v1.11.0-water.1

replace github.com/refraction-networking/water => github.com/getlantern/water v0.7.1-alpha.0.20260309190745-bd547c14b4aa

replace golang.getoutline.org/sdk/x => github.com/getlantern/outline-sdk/x v0.3.0-lantern.3

replace golang.getoutline.org/sdk => github.com/getlantern/outline-sdk v0.1.0-lantern.1

replace github.com/sagernet/gvisor => github.com/sagernet/gvisor v0.0.0-20260727.0-sing-box-mod.1
